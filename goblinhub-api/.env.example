NODE_ENV=development

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql://usuario:contrasena@host:5432/nombre_bd?schema=public
# Usa conexión directa o Supavisor session mode (puerto 5432), no transaction mode.
BACKUP_DATABASE_URL=postgresql://goblinhub_backup_user:contrasena@host:5432/nombre_bd?sslmode=require
RESTORE_DATABASE_URL=postgresql://goblinhub_restore_user:contrasena@host:5432/nombre_bd?sslmode=require

SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
SUPABASE_URL=https://tu_proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui
SUPABASE_RESET_PASSWORD_URL=http://localhost:5173/reset-password

PORT=3000

# Entorno de despliegue. Etiqueta constante de todas las métricas (FR-006) y
# variable del filtro $env del tablero. Valores admitidos:
# development | staging | production. Si el valor no está en la lista, la API
# arranca con error en lugar de publicar métricas con una etiqueta inválida.
DEPLOY_ENV=development

# Máximo de conexiones del pool de PostgreSQL. Alimenta la métrica
# goblinhub_prisma_pool_connections_max y la alerta A-06 (pool saturado).
DATABASE_POOL_MAX=10

# Throttling global (ventana de 60s por IP). Default: 10 req/min.
# Para pruebas de carga, relaja el límite p. ej. THROTTLE_LIMIT=10000
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Throttling especifico POST /auth/signin (ventana 90s por IP). Default: 5 req/90s.
# Para pruebas de carga, relaja el límite p. ej. AUTH_SIGNIN_THROTTLE_LIMIT=10000
AUTH_SIGNIN_THROTTLE_TTL=90000
AUTH_SIGNIN_THROTTLE_LIMIT=5

# Redis Config
REDIS_URL=redis://localhost:6379

# --- Trazabilidad (#204) -----------------------------------------------------
# Los tres valores cubren el «definir retención, niveles de log» del alcance.
# Ninguno es obligatorio: si falta alguno se usa el valor por defecto, y si un
# valor es inválido la API avisa por log y arranca igual con el valor por
# defecto. Ninguna de estas variables contiene secretos.

# Nombre del servicio que atiende la petición. Es el valor por el que se
# filtran las trazas en el visor, así que un despliegue por entorno debería
# distinguirse aquí (por ejemplo, el mismo nombre en todos ellos, o uno propio
# si un día hay más de un proceso).
TRAZAS_SERVICIO=goblinhub-api

# Nivel a partir del cual se guarda una traza: info | warn | error.
# El nivel de cada traza se deriva de su código de respuesta (info por debajo de
# 400, warn en 4xx, error en 5xx). Con `error` solo se guardan los fallos, que es
# el margen de volumen más bajo antes de un despliegue.
TRAZAS_NIVEL_MINIMO=info

# Días que se conservan las trazas antes de que el trabajo programado las
# elimine. La purga corre a las 03:17 y borra en cascada los pasos de cada
# traza. Default: 7.
TRAZAS_RETENCION_DIAS=7
