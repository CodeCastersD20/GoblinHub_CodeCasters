NODE_ENV=development

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql://usuario:contrasena@host:5432/nombre_bd?schema=public
# Usa conexión directa o Supavisor session mode (puerto 5432), no transaction mode.
BACKUP_DATABASE_URL=postgresql://goblinhub_backup_user:contrasena@host:5432/nombre_bd?sslmode=require
RESTORE_DATABASE_URL=postgresql://goblinhub_restore_user:contrasena@host:5432/nombre_bd?sslmode=require

SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
SUPABASE_URL=https://tu_proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui
SUPABASE_RESET_PASSWORD_URL=http://localhost:5173/reset-password

PORT=3000
