          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.titulo AS \"Evento\", CASE WHEN e.cupo_maximo = 0 THEN 0 ELSE LEAST(100.0 * COUNT(i.id_inscripcion) / e.cupo_maximo, 100) END AS \"Ocupación\" FROM eventos e LEFT JOIN inscripciones i ON i.id_evento = e.id_evento AND i.deleted_at IS NULL WHERE e.deleted_at IS NULL GROUP BY e.id_evento, e.titulo, e.cupo_maximo ORDER BY 3 DESC LIMIT 10"
