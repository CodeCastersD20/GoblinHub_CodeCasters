# Variables del stack de monitoreo (spec 005, FR-022).
#
# Copia este fichero a `.env` y rellena los valores. El `.env` está ignorado por
# git: NINGÚN valor de este fichero debe versionarse (Principio II).
#
#   cp .env.example .env
#   node scripts/generate-config.mjs
#   docker compose up -d
#
# El generador falla con código distinto de cero si falta una variable
# obligatoria, de modo que una configuración incompleta no llega a CI en verde.

# ─────────────────────────── promoted (obligatorias) ───────────────────────────
# Entorno por defecto para los jobs que no declaran uno propio en el .env.
# Valores admitidos: development | staging | production
DEPLOY_ENV=development

# Destino de los scrape, en forma `host:puerto` (NO una URL: el campo
# `targets` de Prometheus solo admite `host:port` y `promtool check config`
# rechaza una URL completa). En producción, el del servicio de Render.
API_TARGET=host.docker.internal:3010

# Credenciales de la UI de Grafana. Cambia la contraseña antes de exponer la
# UI fuera de la red local.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-esta-contrasena

# ───────────────────── credenciales de notificación ─────────────────────
# Los tres canales del AC de #214. Deja vacío el que no uses: el receptor
# correspondiente se omite del `alertmanager.yml` generado.
#
# Correo (SMTP)
ALERTMANAGER_SMTP_HOST=
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_USERNAME=
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_SMTP_REQUIRE_TLS=true
ALERTMANAGER_EMAIL_FROM=goblinhub@example.com
ALERTMANAGER_EMAIL_TO=equipo@example.com

# Slack (incoming webhook)
SLACK_WEBHOOK_URL=

# Discord (webhook)
DISCORD_WEBHOOK_URL=

# Receptor webhook de pruebas. Apunta al receptor simulado local
# (`node scripts/mock-webhook.mjs`) y solo se usa para adjuntar la evidencia de
# una alerta disparada (T043/T044). Déjalo vacío en producción.
ALERTMANAGER_MOCK_WEBHOOK_URL=

# ─────────────── datasource de métricas de negocio (opcional) ───────────────
# Solo lectura sobre la base de datos existente (FR-019). Si lo dejas vacío, el
# panel de negocio aparece sin datasource y la sección queda vacía; el resto del
# tablero funciona igual.
# Ojo: en PostgreSQL el rol de solo lectura se concede con REVOKE sobre
# INSERT/UPDATE/DELETE y sobre las secuencias del esquema public; ver
# `sql/create-readonly-role.sql`.
BUSINESS_DB_HOST=
BUSINESS_DB_PORT=5432
BUSINESS_DB_NAME=postgres
BUSINESS_DB_USER=goblinhub_ro
BUSINESS_DB_PASSWORD=
BUSINESS_DB_SSLMODE=require

# ─────────────────────────────oprational (opcionales) ─────────────────────────
# Retención del histórico de Prometheus. Sin espacio, Prometheus deja de
# escribir y TODAS las alertas se apagan en silencio (alerta A-14).
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB

# Intervalo de scrape. 15 s es el mínimo razonable para ver una degradación
# antes de que la reporte un usuario.
PROMETHEUS_SCRAPE_INTERVAL=15s

# Puerto de la UI de Alertmanager (siempre activa, no requiere credenciales:
# es el canal de respaldo mientras el equipo configura los demás).
ALERTMANAGER_PORT=9093
